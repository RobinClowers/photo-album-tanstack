# Staging build configuration, loaded by `bun run build --mode staging`
# (that is what `bun run deploy:staging` runs). Non-secret only; secrets
# belong in .dev.vars locally and `wrangler secret put NAME --env staging`
# for the deployed Worker.
#
# CLOUDFLARE_ENV is what actually selects env.staging in wrangler.jsonc: the
# Cloudflare Vite plugin reads it via vite.loadEnv(mode, root, ['CLOUDFLARE_'])
# and bakes the resolved environment into dist/server/wrangler.json. `--mode
# staging` alone only switches Vite's mode and would emit the PRODUCTION
# worker config with staging asset URLs baked in.
CLOUDFLARE_ENV=staging

# Custom domain of the robin-photos-staging R2 bucket.
VITE_PHOTO_BASE_URL=https://img-staging.robinclowers.com/
