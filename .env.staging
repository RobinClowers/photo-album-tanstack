# Staging build configuration, loaded by Vite for `--mode staging` (that is
# what `bun run deploy:staging` builds with). Non-secret only; secrets belong
# in .dev.vars locally and `cf workers secrets update` for the deployed Worker.
#
# The mode alone selects the staging Worker: cloudflare.config.ts switches on
# ctx.mode, which is Vite's --mode. CLOUDFLARE_ENV is no longer read.

# Custom domain of the robin-photos-staging R2 bucket.
VITE_PHOTO_BASE_URL=https://img-staging.robinclowers.com/
