# Loaded by Vite in `bun run dev` only (mode "development"). Build-time,
# non-secret values; secrets belong in .dev.vars.

# Serve photos from the emulated R2 bucket via src/routes/dev-images.$.ts, so
# locally imported or reprocessed photos render; keys the local bucket lacks
# redirect to the production image domain. Deployed builds use .env.staging
# or the default in src/utils/photo.ts instead.
VITE_PHOTO_BASE_URL=/dev-images/
