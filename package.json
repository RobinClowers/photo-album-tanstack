{
  "name": "photo-album-tanstack",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run --passWithNoTests",
    "deploy": "bun run build && cf deploy --prebuilt",
    "deploy:staging": "bun run build --mode staging && cf deploy --prebuilt",
    "preview": "bun run build && vite preview",
    "cf-typegen": "cf workers types",
    "db": "bun scripts/d1.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/d1.ts prod --migrate",
    "db:migrate:staging": "bun scripts/d1.ts staging --migrate",
    "db:local": "bun scripts/d1.ts local --migrate",
    "db:studio": "drizzle-kit studio",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "check": "biome check .",
    "typecheck": "cf workers types && tsc --noEmit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-router": "^1.169.1",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.59",
    "@tanstack/router-plugin": "^1.167.32",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "exifr": "^7.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cf": "1.0.0-beta.5",
    "jsdom": "^27.0.0",
    "lefthook": "^2.1.12",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  }
}
