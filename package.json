{
  "name": "photo-album-tanstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "deploy": "bun run build && wrangler deploy",
    "preview": "bun run build && vite preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply photo-album --remote",
    "db:local": "wrangler d1 migrations apply photo-album --local",
    "db:studio": "drizzle-kit studio",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.13.8",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/material-pigment-css": "^7.3.7",
    "@pigment-css/react": "^0.0.30",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-router": "^1.169.1",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.59",
    "@tanstack/router-plugin": "^1.167.32",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "justified-layout": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@pigment-css/vite-plugin": "^0.0.30",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.59.2"
  }
}
